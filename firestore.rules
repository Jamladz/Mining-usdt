rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
    // Users collection: read-only from client-side
    match /users/{userId} {
      allow read: if true;
      allow write: if false;
    }
    // Referrals collection: read-only from client-side
    match /referrals/{referralId} {
      allow read: if true;
      allow write: if false;
    }
    // Withdrawals collection: read-only from client-side
    match /withdrawals/{withdrawalId} {
      allow read: if true;
      allow write: if false;
    }
    // Mining claims collection: read-only from client-side
    match /mining_claims/{claimId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
