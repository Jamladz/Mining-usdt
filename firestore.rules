rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
    // Public users collection for Telegram ID search and profile synchronization
    match /users/{userId} {
      // Read is open to allow searching by any Telegram user
      allow read: if true;
      
      // Write is allowed to synchronize their own Telegram Profile
      allow create, update: if request.resource.data.id == userId;
    }
    // Secure referrals collection
    match /referrals/{referralId} {
      // Read is open to allow loading referral histories
      allow read: if true;
      // Create is allowed if registering the referral mapping where the document ID is the referred user ID
      allow create: if request.resource.data.referredUserId == referralId;
      // Update and delete are forbidden as referral records are immutable
      allow update, delete: if false;
    }
    // Withdrawals collection
    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }
  }
}
